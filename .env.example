# ───────── TAWA server configuration ─────────
# Copy to .env (never commit it). In production set these as real environment variables / secrets.

NODE_ENV=development
PORT=4000

# Public URL of the storefront. MUST be https in production. Used in emails and for CORS/origin checks.
APP_URL=http://localhost:5173
# Extra allowed browser origins (comma separated), e.g. https://www.tawacandles.com
CORS_ORIGINS=
# Number of reverse proxies in front of the app (1 for most PaaS / nginx / Cloudflare-less setups).
TRUST_PROXY=0
# Serve the built storefront (../client/dist) from this server — single-container deployment.
SERVE_CLIENT=false

# PostgreSQL (Neon, Supabase, RDS, local…). Leave EMPTY in development to use the embedded dev database.
DATABASE_URL=
DATABASE_SSL=true

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
DATA_ENCRYPTION_KEY=

ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14
ADMIN_REQUIRE_MFA=true

# Outgoing email via Brevo (Brevo dashboard → SMTP & API → API Keys).
# SENDER_EMAIL must be a sender/domain you verified in Brevo. STORE_NOTIFY_EMAIL receives new-order / message / custom-request alerts.
BREVO_API_KEY=
SENDER_EMAIL=
SENDER_NAME="TAWA Candles"
STORE_NOTIFY_EMAIL=hello@tawacandles.com

# M-Pesa (Safaricom Daraja). MPESA_MODE: mock (dev only) | sandbox | production
MPESA_MODE=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS base URL Safaricom can reach, e.g. https://shop.tawacandles.com
MPESA_CALLBACK_BASE=
# Long random string placed in the callback URL path (24+ chars)
MPESA_CALLBACK_SECRET=

UPLOAD_DIR=uploads
LOG_LEVEL=info

# Cloudflare R2 for product images (Cloudflare → R2 → Manage API Tokens → Object Read & Write).
# Leave empty to disable image uploads. R2_PUBLIC_URL: r2.dev URL (dev only) or a custom domain, no trailing slash.
R2_ACCOUNT_ID=62bd497a59056a5899db3f2bd7e99d31
R2_ACCESS_KEY_ID=7ea134ffeb35d7e4feb68e411c0ab79e
R2_SECRET_ACCESS_KEY=71f4a1ae868b0ceb5780ace992fce3fddfb6e3fe6f3f4949b8d70a11a09e8793
R2_BUCKET=tawa-images
R2_PUBLIC_URL=https://pub-279dc8a8ab1841c2b78a3099e4569af4.r2.dev
